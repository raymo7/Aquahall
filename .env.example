# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables instead.
# Never commit the real .env.local — it's already in .gitignore.

# --- Database (Neon Postgres) ---
# Get this by adding the Neon integration from the Vercel Marketplace to this project,
# or from https://console.neon.tech if you create a Neon project directly.
# Vercel's Neon integration usually injects this automatically as DATABASE_URL —
# check your Vercel project's Environment Variables tab after connecting and adjust
# the variable name here if it differs (e.g. POSTGRES_URL).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Email (Resend) ---
# Get a free API key at https://resend.com (3,000 emails/month, 100/day on Free)
RESEND_API_KEY=re_your_api_key_here

# Who booking/payment emails appear to come "from". Until you verify your own domain
# in Resend, use their shared test sender below — it works immediately, no setup.
EMAIL_FROM=Aqua Haul <onboarding@resend.dev>

# Comma-separated list of addresses that get every booking/enquiry/payment notification
OWNER_EMAILS=aquahaul360@gmail.com,rayrey311@gmail.com

# --- Admin dashboard login ---
# Choose your own password — this gates the "View bookings" screen. Change it from the example.
ADMIN_PASSWORD=change-this-password

# Random long string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-64-char-hex-string

# --- Payment (Google Pay / UPI) ---
NEXT_PUBLIC_UPI_ID=shonecyriac@okaxis
NEXT_PUBLIC_UPI_PAYEE_NAME=Aqua Haul
